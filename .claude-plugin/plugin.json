{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "atomistic-skills",
  "displayName": "Atomistic Skills",
  "description": "Agent skills for atomistic simulation: materials science, chemistry, drug discovery, and machine-learning interatomic potentials.",
  "version": "1.4.0",
  "author": {
    "name": "Learning Matter Lab, MIT",
    "url": "https://github.com/learningmatter-mit"
  },
  "homepage": "https://github.com/learningmatter-mit/AtomisticSkills",
  "repository": "https://github.com/learningmatter-mit/AtomisticSkills",
  "license": "MIT",
  "keywords": [
    "materials-science",
    "chemistry",
    "drug-discovery",
    "machine-learning",
    "atomistic-simulation",
    "mlip",
    "dft"
  ],
  "mcpServers": {
    "atomate2": {
      "command": "${CLAUDE_PLUGIN_ROOT}/docker/run_server.sh",
      "args": [
        "atomate2"
      ],
      "env": {
        "ATOMISTIC_RUNTIME": "${user_config.container_runtime}",
        "ATOMISTIC_IMAGE": "${user_config.image_registry}/atomisticskills-lightweight:${user_config.image_tag}",
        "ATOMISTIC_IMAGE_NAME": "lightweight",
        "ATOMISTIC_PLATFORMS": "linux/amd64,linux/arm64",
        "ATOMISTIC_WORK_DIR": "${user_config.work_dir}",
        "ATOMISTIC_MODEL_CACHE": "${CLAUDE_PLUGIN_DATA}/model-cache",
        "ATOMISTIC_GPU": "0"
      }
    },
    "base": {
      "command": "${CLAUDE_PLUGIN_ROOT}/docker/run_server.sh",
      "args": [
        "base"
      ],
      "env": {
        "ATOMISTIC_RUNTIME": "${user_config.container_runtime}",
        "ATOMISTIC_IMAGE": "${user_config.image_registry}/atomisticskills-lightweight:${user_config.image_tag}",
        "ATOMISTIC_IMAGE_NAME": "lightweight",
        "ATOMISTIC_PLATFORMS": "linux/amd64,linux/arm64",
        "ATOMISTIC_WORK_DIR": "${user_config.work_dir}",
        "ATOMISTIC_MODEL_CACHE": "${CLAUDE_PLUGIN_DATA}/model-cache",
        "ATOMISTIC_GPU": "0"
      }
    },
    "drugdisc": {
      "command": "${CLAUDE_PLUGIN_ROOT}/docker/run_server.sh",
      "args": [
        "drugdisc"
      ],
      "env": {
        "ATOMISTIC_RUNTIME": "${user_config.container_runtime}",
        "ATOMISTIC_IMAGE": "${user_config.image_registry}/atomisticskills-lightweight:${user_config.image_tag}",
        "ATOMISTIC_IMAGE_NAME": "lightweight",
        "ATOMISTIC_PLATFORMS": "linux/amd64,linux/arm64",
        "ATOMISTIC_WORK_DIR": "${user_config.work_dir}",
        "ATOMISTIC_MODEL_CACHE": "${CLAUDE_PLUGIN_DATA}/model-cache",
        "ATOMISTIC_GPU": "0"
      }
    },
    "smol": {
      "command": "${CLAUDE_PLUGIN_ROOT}/docker/run_server.sh",
      "args": [
        "smol"
      ],
      "env": {
        "ATOMISTIC_RUNTIME": "${user_config.container_runtime}",
        "ATOMISTIC_IMAGE": "${user_config.image_registry}/atomisticskills-lightweight:${user_config.image_tag}",
        "ATOMISTIC_IMAGE_NAME": "lightweight",
        "ATOMISTIC_PLATFORMS": "linux/amd64,linux/arm64",
        "ATOMISTIC_WORK_DIR": "${user_config.work_dir}",
        "ATOMISTIC_MODEL_CACHE": "${CLAUDE_PLUGIN_DATA}/model-cache",
        "ATOMISTIC_GPU": "0"
      }
    },
    "mace": {
      "command": "${CLAUDE_PLUGIN_ROOT}/docker/run_server.sh",
      "args": [
        "mace"
      ],
      "env": {
        "ATOMISTIC_RUNTIME": "${user_config.container_runtime}",
        "ATOMISTIC_IMAGE": "${user_config.image_registry}/atomisticskills-mace:${user_config.image_tag}",
        "ATOMISTIC_IMAGE_NAME": "mace",
        "ATOMISTIC_PLATFORMS": "linux/amd64,linux/arm64",
        "ATOMISTIC_WORK_DIR": "${user_config.work_dir}",
        "ATOMISTIC_MODEL_CACHE": "${CLAUDE_PLUGIN_DATA}/model-cache",
        "ATOMISTIC_GPU": "1"
      }
    },
    "matgl": {
      "command": "${CLAUDE_PLUGIN_ROOT}/docker/run_server.sh",
      "args": [
        "matgl"
      ],
      "env": {
        "ATOMISTIC_RUNTIME": "${user_config.container_runtime}",
        "ATOMISTIC_IMAGE": "${user_config.image_registry}/atomisticskills-mace:${user_config.image_tag}",
        "ATOMISTIC_IMAGE_NAME": "mace",
        "ATOMISTIC_PLATFORMS": "linux/amd64,linux/arm64",
        "ATOMISTIC_WORK_DIR": "${user_config.work_dir}",
        "ATOMISTIC_MODEL_CACHE": "${CLAUDE_PLUGIN_DATA}/model-cache",
        "ATOMISTIC_GPU": "1"
      }
    },
    "fairchem": {
      "command": "${CLAUDE_PLUGIN_ROOT}/docker/run_server.sh",
      "args": [
        "fairchem"
      ],
      "env": {
        "ATOMISTIC_RUNTIME": "${user_config.container_runtime}",
        "ATOMISTIC_IMAGE": "${user_config.image_registry}/atomisticskills-fairchem:${user_config.image_tag}",
        "ATOMISTIC_IMAGE_NAME": "fairchem",
        "ATOMISTIC_PLATFORMS": "linux/amd64,linux/arm64",
        "ATOMISTIC_WORK_DIR": "${user_config.work_dir}",
        "ATOMISTIC_MODEL_CACHE": "${CLAUDE_PLUGIN_DATA}/model-cache",
        "ATOMISTIC_GPU": "1"
      }
    },
    "adit": {
      "command": "${CLAUDE_PLUGIN_ROOT}/docker/run_server.sh",
      "args": [
        "adit"
      ],
      "env": {
        "ATOMISTIC_RUNTIME": "${user_config.container_runtime}",
        "ATOMISTIC_IMAGE": "${user_config.image_registry}/atomisticskills-generative:${user_config.image_tag}",
        "ATOMISTIC_IMAGE_NAME": "generative",
        "ATOMISTIC_PLATFORMS": "linux/arm64",
        "ATOMISTIC_WORK_DIR": "${user_config.work_dir}",
        "ATOMISTIC_MODEL_CACHE": "${CLAUDE_PLUGIN_DATA}/model-cache",
        "ATOMISTIC_GPU": "1"
      }
    },
    "diffcsp": {
      "command": "${CLAUDE_PLUGIN_ROOT}/docker/run_server.sh",
      "args": [
        "diffcsp"
      ],
      "env": {
        "ATOMISTIC_RUNTIME": "${user_config.container_runtime}",
        "ATOMISTIC_IMAGE": "${user_config.image_registry}/atomisticskills-generative:${user_config.image_tag}",
        "ATOMISTIC_IMAGE_NAME": "generative",
        "ATOMISTIC_PLATFORMS": "linux/arm64",
        "ATOMISTIC_WORK_DIR": "${user_config.work_dir}",
        "ATOMISTIC_MODEL_CACHE": "${CLAUDE_PLUGIN_DATA}/model-cache",
        "ATOMISTIC_GPU": "1"
      }
    },
    "mattergen": {
      "command": "${CLAUDE_PLUGIN_ROOT}/docker/run_server.sh",
      "args": [
        "mattergen"
      ],
      "env": {
        "ATOMISTIC_RUNTIME": "${user_config.container_runtime}",
        "ATOMISTIC_IMAGE": "${user_config.image_registry}/atomisticskills-generative:${user_config.image_tag}",
        "ATOMISTIC_IMAGE_NAME": "generative",
        "ATOMISTIC_PLATFORMS": "linux/arm64",
        "ATOMISTIC_WORK_DIR": "${user_config.work_dir}",
        "ATOMISTIC_MODEL_CACHE": "${CLAUDE_PLUGIN_DATA}/model-cache",
        "ATOMISTIC_GPU": "1"
      }
    }
  },
  "userConfig": {
    "container_runtime": {
      "type": "string",
      "title": "Container runtime",
      "description": "Command used to run the server images: docker, podman, apptainer or singularity. On HPC clusters, where users have no root and no Docker daemon, use apptainer.",
      "default": "docker",
      "required": true
    },
    "work_dir": {
      "type": "directory",
      "title": "Working directory",
      "description": "Directory bound into the containers at /work. Simulation inputs are read from here and all results are written back here, so it must be the project you want the skills to operate on.",
      "required": true
    },
    "image_registry": {
      "type": "string",
      "title": "Image registry",
      "description": "Registry namespace holding the atomisticskills-* server images. Change this only if you are testing images published from a fork, e.g. ghcr.io/<your-github-user>.",
      "default": "ghcr.io/learningmatter-mit",
      "required": true
    },
    "image_tag": {
      "type": "string",
      "title": "Image tag",
      "description": "Tag of the atomisticskills-* images to run. Defaults to the plugin version so the images match the skills that call them.",
      "default": "1.4.0",
      "required": true
    }
  }
}
