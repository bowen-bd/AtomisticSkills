# The GPU images: mace, fairchem and generative.
#
# Each of these installs its environments from exact lockfiles rather than from
# a spec, because none of them can be resolved:
#
#   * mace-torch 0.3.15 pins e3nn==0.4.4 while fairchem-core needs e3nn>=0.5,
#     so those two can never share an environment -- hence separate images.
#   * fairchem-core 2.19.0 declares torch~=2.8.0, but the working environment
#     runs torch 2.10.0 because torch 2.8 ships no sm_121 / aarch64 / CUDA 13
#     build. A resolver asked to honour that constraint fails.
#
# The locks are therefore installed with --no-deps: they are already closed, and
# re-resolving them would either fail or silently produce versions other than
# the ones the skills were validated against.
#
# Every environment named in the image's `envs` list is installed side by side
# under its original name, so behaviour inside the container matches the
# corresponding conda env exactly.
#
# Build (one image at a time; IMAGE_NAME selects the env set):
#   docker buildx build -f docker/Dockerfile.cuda \
#     --platform linux/arm64 --build-arg IMAGE_NAME=mace \
#     --build-arg CONDA_ENVS="mace-agent matgl-agent" \
#     -t ghcr.io/learningmatter-mit/atomisticskills-mace:dev .
FROM nvidia/cuda:13.0.1-devel-ubuntu24.04

ARG TARGETARCH
ARG IMAGE_NAME
ARG CONDA_ENVS
ARG CONDA_SUBDIR=linux-aarch64
# GB10 is sm_121. The amd64 build targets datacenter and recent consumer cards.
ARG TORCH_CUDA_ARCH_LIST="12.1"
# "env=version" pairs, used only where no conda lock exists for CONDA_SUBDIR.
# The aarch64 locks were frozen from built environments; the amd64 side resolves
# its pip layer instead (docker/resolve_locks.py), so its conda layer is just
# the interpreter -- the torch wheels carry their own CUDA runtime.
ARG CONDA_ENV_PYTHON=""
# The aarch64 wheels come from the PyTorch CUDA 13 index. The amd64 pins resolve
# against PyPI, whose x86_64 torch wheels are already CUDA builds, and mixing a
# second index there risks silently substituting a different build.
ARG PIP_EXTRA_INDEX_URL="https://download.pytorch.org/whl/cu130"
# Set to 1 for the generative image, whose PyG extensions have no prebuilt
# wheels for aarch64 + CUDA 13 and must be compiled here.
ARG PYG_FROM_SOURCE=0

ENV REPO_DIR=/opt/atomisticskills \
    MAMBA_ROOT_PREFIX=/opt/micromamba \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git ca-certificates curl bzip2 build-essential util-linux \
    && rm -rf /var/lib/apt/lists/*

# micromamba resolves and installs far faster than conda for explicit locks.
RUN set -eux; \
    case "${TARGETARCH}" in \
      arm64) MAMBA_ARCH=linux-aarch64 ;; \
      amd64) MAMBA_ARCH=linux-64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    mkdir -p /opt/micromamba/bin; \
    curl -Ls "https://micro.mamba.pm/api/micromamba/${MAMBA_ARCH}/latest" \
      | tar -xvj -C /opt/micromamba/bin --strip-components=1 bin/micromamba
ENV PATH=/opt/micromamba/bin:${PATH}

WORKDIR ${REPO_DIR}

# Lockfiles first: they change far less often than the source tree, so the
# multi-GB install layers stay cached across ordinary code edits.
COPY conda-envs/ ${REPO_DIR}/conda-envs/

# Conda layer per environment: exact URLs with checksums from
# `conda list --explicit --md5`.
RUN set -eux; \
    for env in ${CONDA_ENVS}; do \
        lock="${REPO_DIR}/conda-envs/${env}/lock/conda-${CONDA_SUBDIR}.txt"; \
        if [ -f "${lock}" ]; then \
            echo "== conda layer: ${env} (from lock)"; \
            micromamba create -y -n "${env}" -f "${lock}"; \
        else \
            py=$(printf '%s' "${CONDA_ENV_PYTHON}" | tr ' ' '\n' \
                 | sed -n "s/^${env}=//p" | head -1); \
            test -n "${py}" || { \
                echo "no conda lock at ${lock} and no python version for ${env}" >&2; \
                echo "add it to env_python in docker/images.json" >&2; exit 1; }; \
            echo "== conda layer: ${env} (bare python ${py})"; \
            micromamba create -y -n "${env}" -c conda-forge "python=${py}" pip; \
        fi; \
    done; \
    micromamba clean --all --yes

# pip layer per environment, --no-deps because the lock is already closed and
# several pins deliberately contradict upstream metadata (see header).
RUN set -eux; \
    for env in ${CONDA_ENVS}; do \
        lock="${REPO_DIR}/conda-envs/${env}/lock/pip-${CONDA_SUBDIR}.txt"; \
        test -f "${lock}" || { echo "missing pip lock: ${lock}" >&2; exit 1; }; \
        echo "== pip layer: ${env}"; \
        if [ -n "${PIP_EXTRA_INDEX_URL}" ]; then \
            micromamba run -n "${env}" python -m pip install --no-cache-dir --no-deps \
                --extra-index-url "${PIP_EXTRA_INDEX_URL}" -r "${lock}"; \
        else \
            micromamba run -n "${env}" python -m pip install --no-cache-dir --no-deps \
                -r "${lock}"; \
        fi; \
    done

# torch-scatter / torch-cluster / torch-sparse: no aarch64 + CUDA 13 wheels
# exist, so they are compiled against the torch already present in each env.
# --no-build-isolation is required so the build sees that torch.
RUN set -eux; \
    if [ "${PYG_FROM_SOURCE}" = "1" ]; then \
      for env in ${CONDA_ENVS}; do \
        echo "== PyG extensions from source: ${env} (arch ${TORCH_CUDA_ARCH_LIST})"; \
        for pkg in pytorch_scatter pytorch_cluster pytorch_sparse; do \
          micromamba run -n "${env}" python -m pip install \
            --no-build-isolation --no-cache-dir \
            "git+https://github.com/rusty1s/${pkg}.git"; \
        done; \
      done; \
    else \
      echo "PyG source build not requested for ${IMAGE_NAME}" >&2; \
    fi

COPY src/ ${REPO_DIR}/src/
COPY skills/ ${REPO_DIR}/skills/
COPY docker/images.json docker/render.py docker/entrypoint.sh ${REPO_DIR}/docker/
COPY pyproject.toml ${REPO_DIR}/

# Render the server table using the first environment's interpreter.
RUN set -eux; \
    first_env="$(echo ${CONDA_ENVS} | awk '{print $1}')"; \
    micromamba run -n "${first_env}" python ${REPO_DIR}/docker/render.py \
        server-map "${IMAGE_NAME}" > ${REPO_DIR}/docker/server-map.txt; \
    chmod +x ${REPO_DIR}/docker/entrypoint.sh; \
    cat ${REPO_DIR}/docker/server-map.txt

ENV HF_HOME=/opt/model-cache/huggingface \
    TORCH_HOME=/opt/model-cache/torch
RUN mkdir -p /opt/model-cache /work && chmod 777 /opt/model-cache /work

VOLUME ["/opt/model-cache", "/work"]
WORKDIR /work

ENTRYPOINT ["/opt/atomisticskills/docker/entrypoint.sh"]
