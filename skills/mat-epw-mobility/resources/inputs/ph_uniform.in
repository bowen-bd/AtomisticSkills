Phonon calculation for monolayer ZrS2 (6x6x1 uniform q)
&inputph
  prefix    = 'zrs2'
  outdir    = './tmp'
  fildyn    = 'zrs2.dyn'
  fildvscf  = 'dvscf'              ! REQUIRED for the EPW long-range kernel
  tr2_ph    = 1.0d-14
  ldisp     = .true.
  nq1       = 6
  nq2       = 6
  nq3       = 1                    ! 2D: always 1
  epsil     = .true.
  zeu       = .true.
  recover   = .true.              ! restart on timeout; only loses in-progress q
/
