Epsilon and Z* at Gamma (ZrS2 monolayer, 2D slab)
&inputph
  prefix     = 'zrs2'
  outdir     = './tmp'
  fildyn     = 'dyn_q0'
  tr2_ph     = 1.0d-14             ! monolayer; 1.0d-12 for bilayer/thicker
  ldisp      = .false.
  epsil      = .true.             ! high-frequency dielectric tensor
  zeu        = .true.             ! Born effective charges
/
0.0 0.0 0.0
